# CLYMEX AI - Environment Configuration Example
# "Predict Risk. Protect Tomorrow."

# General Environment
ENV=development
DEMO_MODE=true

# Security
SECRET_KEY=clymex-ai-super-secure-jwt-secret-key-2026-incomati-resilience
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Regional Context
DEFAULT_COUNTRY=Mozambique
DEFAULT_REGION=Greater Maputo / Incomati Basin
DEFAULT_CENTER_LAT=-25.55
DEFAULT_CENTER_LNG=32.75
DEFAULT_ZOOM=9

# Database & Cache (Production)
DATABASE_URL=postgresql://clymex:clymex2026@localhost:5432/clymex_risk
